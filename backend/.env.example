DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Free key from https://account.heigit.org/ — never commit the real value.
ORS_API_KEY=

# Production is set on Render, not in this file.
# DJANGO_DEBUG=false needs a unique DJANGO_SECRET_KEY.
# DJANGO_ALLOWED_HOSTS is the onrender.com host.
# CORS_ALLOWED_ORIGINS is the Vercel origin, with no trailing slash.
